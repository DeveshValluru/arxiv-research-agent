HF_TOKEN=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=
SEMANTIC_SCHOLAR_API_KEY=
# Sent in the User-Agent so arXiv can contact you (polite API use)
ARXIV_CONTACT_NAME=
ARXIV_CONTACT_EMAIL=
# Local Postgres from compose.yaml: pick any password, use it in both lines.
# 127.0.0.1, not localhost: on Windows, localhost tries IPv6 first and hangs ~2 min
# before falling back.
POSTGRES_PASSWORD=
DATABASE_URL=postgresql://arxiv:<POSTGRES_PASSWORD>@127.0.0.1:5432/arxiv
